<?xml version="1.0"?>

<sdf version="1.9">

  <model name="blue_object">

    <!-- Dynamic version used only after RELEASE -->
    <static>false</static>

    <link name="link">

      <gravity>true</gravity>

      <!-- =============================== -->
      <!-- VISUAL -->
      <!-- =============================== -->

      <visual name="visual">

        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>

        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>

      </visual>

      <!-- =============================== -->
      <!-- COLLISION -->
      <!-- =============================== -->

      <collision name="collision">

        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>

      </collision>

      <!-- =============================== -->
      <!-- INERTIA -->
      <!-- =============================== -->

      <inertial>

        <mass>0.05</mass>

        <inertia>
          <ixx>0.00001333</ixx>
          <iyy>0.00001333</iyy>
          <izz>0.00001333</izz>

          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>

      </inertial>

    </link>

  </model>

</sdf>
